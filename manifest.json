{
  "manifest_version": 3,
  "name": "Instagram Focus",
  "version": "1.0.0",
  "description": "Keep Instagram on DMs and profile search only. Pause for 1, 5, or 15 minutes when you need the feed.",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Instagram Focus",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.instagram.com/*",
        "*://instagram.com/*",
        "*://m.instagram.com/*"
      ],
      "js": ["classify.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
